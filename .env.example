# Formulario de contacto (SPEC 03) — copia este archivo a .env.local y rellena los valores.
# .env.local no se versiona (.gitignore excluye .env*); este archivo NO lleva valores reales.

# API key de Resend (https://resend.com/api-keys). Solo se lee en el servidor.
RESEND_API_KEY=

# Remitente. Sin dominio verificado usa onboarding@resend.dev.
CONTACT_FROM_EMAIL=

# Destinatario (equipo). Con onboarding@resend.dev debe ser el correo de tu cuenta de Resend.
CONTACT_TO_EMAIL=
